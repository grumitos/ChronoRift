{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoRift",
  "version": "0.1.0",
  "identifier": "app.chronorift.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ChronoRift",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https://ddragon.leagueoflegends.com https://raw.communitydragon.org",
        "connect-src": "'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "img-src": "'self' data: https://ddragon.leagueoflegends.com https://raw.communitydragon.org",
        "connect-src": "'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
